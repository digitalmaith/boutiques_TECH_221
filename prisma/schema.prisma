// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int       @id @default(autoincrement())
  email     String    @unique(map: "User_email_unique")
  password  String
  nom       String
  prenom    String
  role      String    @default("USER")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}


// Modèle Magasin
model Magasin {
  id        Int       @id @default(autoincrement())
  nom       String
  adresse   String
  ville     String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  employes  Employe[]

  @@unique([nom, ville])
}

enum Poste {
  CAISSIER
  VENDEUR
  MANAGER
}

// Modèle Employe
model Employe {
  id        Int       @id @default(autoincrement())
  prenom    String
  nom       String
  poste     Poste    // Enum: Caissier, Vendeur, Manager
  telephone String  @unique
  
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  magasinId Int
  magasin   Magasin  @relation(fields: [magasinId], references: [id], onDelete: Restrict)

  ventes    Vente[]

  @@index([magasinId])
}

// Modèle Categorie
model Categorie {
  id            Int       @id @default(autoincrement())
  code          String
  libelle       String
  sousCategorie String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  produits      Produit[]

  @@unique([code, sousCategorie])
}

// Modèle Produit
model Produit {
  id          Int       @id @default(autoincrement())
  libelle     String    @unique
  prix        Float
  qteStock    Int
  image       String?   // URL Cloudinary de l'image du produit
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  categorieId Int
  categorie   Categorie @relation(fields: [categorieId], references: [id])

  ventes      Vente[]

  @@index([deletedAt])
  @@index([categorieId])
}

// Modèle Vente
model Vente {
  id            Int      @id @default(autoincrement())
  dateVente     DateTime
  montantTotal  Float
  quantite      Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  employeId     Int
  employe       Employe @relation(fields: [employeId], references: [id])

  produitId     Int
  produit       Produit @relation(fields: [produitId], references: [id])

  @@index([employeId])
  @@index([produitId])
}
