// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


// Modèle Magasin
model Magasin {
  id        Int       @id @default(autoincrement())
  nom       String
  adresse   String
  ville     String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? 

  employes  Employe[]

  @@unique([nom, ville])
}

enum Poste {
  CAISSIER
  VENDEUR
  MANAGER
}

// Modèle Employe
model Employe {
  id        Int       @id @default(autoincrement())
  prenom    String
  nom       String
  poste     Poste    // Enum: Caissier, Vendeur, Manager
  telephone String  @unique
   photoUrl    String?
  
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? 

  magasinId Int
  magasin   Magasin  @relation(fields: [magasinId], references: [id], onDelete: Restrict)

  ventes    Vente[]

  @@index([magasinId])
}

// Modèle Produit
model Produit {
  id        Int       @id @default(autoincrement())
  libelle   String    @unique
  prix      Float
  qteStock  Int
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  ventes    Vente[]

  @@index([deletedAt])
}

// Modèle Vente
model Vente {
  id            Int      @id @default(autoincrement())
  dateVente     DateTime
  montantTotal  Float
  quantite      Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  employeId     Int
  employe       Employe @relation(fields: [employeId], references: [id])

  produitId     Int
  produit       Produit @relation(fields: [produitId], references: [id])

  @@index([employeId])
  @@index([produitId])
}
